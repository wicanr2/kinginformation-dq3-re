FROM dq3-ebitan-test:20260811

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ffmpeg=7:5.1.9-0+deb12u1 \
      xdotool=1:3.20160805.1-5 \
      imagemagick \
 && rm -rf /var/lib/apt/lists/*

LABEL org.opencontainers.image.title="DQ3 Go/Ebitengine promo capture" \
      org.opencontainers.image.version="20260812-r2" \
      org.opencontainers.image.description="DQ3 Ebitengine Xvfb image plus FFmpeg, ImageMagick and xdotool for the multi-layout promo pipeline"

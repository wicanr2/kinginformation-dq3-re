      "layout": {"kind": "dialogue", "columns": 35, "lines_per_page": 4},
      "source": {"kind": "legacy_record", "file": "D3TXT02.TXT", "record": 15},
      "evidence": {"level": "D3", "source_kind": "data_file", "source": "D3TXT02.TXT", "address_space": "record", "address": "15", "consumer": "temporary_role quest request", "doc": "docs/82-romaly-king-production-trace.md"}
    },
    {
      "id": "dq3:text.romaly.king.later_intro",
      "value": "*「我隨時都可以把王位\n讓給你。",
      "glyph_codes": [59, 60, 493, 1081, 782, 556, 229, 456, 530, 186, 795, 65534, 12, 12, 1037, 559, 528, 56, 65535],
      "layout": {"kind": "dialogue", "columns": 35, "lines_per_page": 4},

      "evidence": {"level": "D3", "source_kind": "data_file", "source": "D3TXT02.TXT", "address_space": "record", "address": "46", "consumer": "temporary_role later intro", "doc": "docs/82-romaly-king-production-trace.md"}
    },
    {
      "id": "dq3:text.romaly.king.later_offer",
      "value": "*「此外,再一次代替我\n成為國王如何?",
      "glyph_codes": [59, 60, 715, 920, 55, 573, 401, 572, 921, 1082, 493, 65534, 12, 12, 610, 611, 300, 186, 675, 676, 58, 65535],
      "layout": {"kind": "dialogue", "columns": 35, "lines_per_page": 4},

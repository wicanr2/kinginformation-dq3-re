    {
      "id": "dq3:text.romaly.arena.restore_intro",
      "value": "*「哇─哈─哈,是我啊。\n從前的國王。\n---\n*「但是當國王可不能\n這樣子玩呢。\n---\n*「你做的不錯,\n繼續領導這個國家好嗎?",
      "glyph_codes": [59, 60, 433, 806, 390, 806, 390, 55, 399, 493, 509, 56, 65534, 12, 12, 511, 535, 149, 300, 186, 56, 65532, 59, 60, 508, 399, 1030, 300, 186, 229, 228, 408, 65534, 12, 12, 398, 537, 151, 705, 592, 56, 65532, 59, 60, 528, 434, 149, 228, 719, 55, 65534, 12, 12, 1079, 1094, 266, 143, 398, 546, 300, 657, 441, 534, 58, 65535],

      "source": {"kind": "legacy_record", "file": "D3TXT02.TXT", "record": 48},
      "evidence": {"level": "D3", "source_kind": "data_file", "source": "D3TXT02.TXT", "address_space": "record", "address": "48", "consumer": "temporary_role accept", "doc": "docs/82-romaly-king-production-trace.md"}
    },
    {
      "id": "dq3:text.romaly.king.return_praise",
      "value": "*「喔喔! {變數}啊!\n幹的好,帶回了金皇冠!\n---\n*「你是真正的勇者啊!",
      "glyph_codes": [59, 60, 776, 776, 57, 12, 65525, 509, 57, 65534, 12, 12, 929, 149, 441, 55, 540, 312, 423, 173, 223, 224, 57, 65532, 59, 60, 528, 399, 577, 588, 149, 106, 187, 509, 57, 65535],

    },
    {
      "id": "dq3:text.romaly.arena.restore_reject",
      "value": "*「太好了,\n這樣我就安心了。",
      "glyph_codes": [59, 60, 334, 441, 423, 55, 65534, 12, 12, 398, 537, 493, 633, 585, 932, 423, 56, 65535],
      "layout": {"kind": "dialogue", "columns": 35, "lines_per_page": 4},

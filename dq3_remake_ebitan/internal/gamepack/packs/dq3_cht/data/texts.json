    },
    {
      "id": "dq3:text.romaly.arena.restore_reconsider",
      "value": "*「什麼,\n已經討厭當國王了嗎?",
      "glyph_codes": [59, 60, 435, 436, 55, 65534, 12, 12, 788, 525, 943, 944, 1030, 300, 186, 423, 534, 58, 65535],
      "layout": {"kind": "dialogue", "columns": 35, "lines_per_page": 4},

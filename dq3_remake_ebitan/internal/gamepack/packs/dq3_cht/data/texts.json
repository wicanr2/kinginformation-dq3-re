    },
    {
      "id": "dq3:text.romaly.king.forced_reject",
      "value": "*「不要說這種推辭的話。",
      "glyph_codes": [59, 60, 228, 504, 909, 398, 281, 1085, 1086, 149, 449, 56, 65535],
      "layout": {"kind": "dialogue", "columns": 35, "lines_per_page": 4},
